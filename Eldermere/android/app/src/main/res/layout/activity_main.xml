<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eldermere_bg_dark">

    <WebView
        android:id="@+id/game_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/eldermere_bg_dark" />

    <!-- Full-bleed Native Launch Loading Screen over WebGL boot -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/eldermere_bg_dark"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/loading_bg_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/splash_loading_bg" />

        <View
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_loading_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_loading_bottom" />

        <!-- Top stylized game crest typography -->
        <LinearLayout
            android:id="@+id/loading_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="44dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.34"
                android:shadowColor="#CC040812"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="@string/loading_kicker"
                android:textColor="@color/eldermere_gold_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="96dp"
                android:layout_height="1.5dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/divider_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.14"
                android:shadowColor="#E603060E"
                android:shadowDy="4"
                android:shadowRadius="10"
                android:text="@string/loading_title"
                android:textColor="@color/eldermere_gold_bright"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:shadowColor="#CC040812"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="@string/loading_tagline"
                android:textColor="@color/eldermere_ink_soft"
                android:textSize="14sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Bottom animated golden progress bar & cycling Eldermere tips -->
        <LinearLayout
            android:id="@+id/loading_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="36dp"
            android:paddingBottom="34dp">

            <TextView
                android:id="@+id/loading_tip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:shadowColor="#F2040812"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="@string/loading_tip_default"
                android:textColor="@color/eldermere_tip_text"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/loading_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:indeterminate="false"
                android:max="1000"
                android:progress="120"
                android:progressDrawable="@drawable/progress_gold_bar" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
