<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/eldermere_progress_track" />
            <stroke
                android:width="1dp"
                android:color="@color/eldermere_progress_stroke" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <gradient
                    android:angle="0"
                    android:centerColor="@color/eldermere_gold"
                    android:endColor="@color/eldermere_gold_bright"
                    android:startColor="@color/eldermere_gold_deep"
                    android:type="linear" />
            </shape>
        </clip>
    </item>
</layer-list>
